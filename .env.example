# Chave secreta das sessões (gere uma: python -c "import secrets; print(secrets.token_hex(32))")
# Se ficar vazia, uma chave de desenvolvimento é criada em instance/secret_key
SECRET_KEY=

# Login com Google (opcional). Crie em https://console.cloud.google.com/apis/credentials
# Tipo: "ID do cliente OAuth" > Aplicativo da Web
# URI de redirecionamento autorizado: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
