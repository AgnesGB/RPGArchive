# Chave secreta das sessões (gere uma: python -c "import secrets; print(secrets.token_hex(32))")
# Local: se ficar vazia, uma chave de desenvolvimento é criada em instance/secret_key
# Produção: obrigatória
SECRET_KEY=

# "production" no servidor (HTTPS, cookie seguro, exige SECRET_KEY). Deixe vazio localmente.
APP_ENV=

# Modo do diário do SQLite. Local: WAL. No PythonAnywhere use DELETE (disco de rede).
SQLITE_JOURNAL_MODE=WAL

# Login com Google (opcional). Crie em https://console.cloud.google.com/apis/credentials
# Tipo: "ID do cliente OAuth" > Aplicativo da Web
# URIs de redirecionamento autorizados:
#   http://localhost:5000/auth/google/callback
#   https://midiri.pythonanywhere.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
